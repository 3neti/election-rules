{
    "name": "3neti/election-rules",
    "description": "Immutable election, office, and contest rules for EMS ballot-style compilation",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\ElectionRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\ElectionRules\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
